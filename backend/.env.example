NODE_ENV=development
PORT=3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://quiz:quiz_password@localhost:5432/quiz_db

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3001

# Signs the session JWT (minimum 32 characters)
JWT_SECRET=dev-secret-change-me-0123456789abcdef
